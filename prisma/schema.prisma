// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Session {
  session_id    String    @id @default(auto()) @map("_id") @db.ObjectId
  id            String    @unique
  shop          String   
  state         String
  isOnline      Boolean  @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String

  userId        String?   // Mongo-safe replacement for BigInt
  firstName     String?
  lastName      String?
  email         String?

  accountOwner  Boolean  @default(false)
  locale        String?
  collaborator  Boolean? @default(false)
  emailVerified Boolean? @default(false)
}

model ScratchConfig {
  shop          String   @id @map("_id")
  enabled       Boolean  @default(true)
  minOrderValue Float    @default(0)
  expiryHours   Int      @default(48)
  expiryValue   Int      @default(48)
  expiryUnit    String   @default("HOURS")
  theme         String   @default("default")
  updatedAt     DateTime @updatedAt
  rewards       RewardTemplate[]
}

model RewardTemplate {
  id               String       @id @default(cuid()) @map("_id")
  shop             String
  label            String
  category         String?
  description      String?
  imageUrl         String?
  collectionId     String?
  collectionHandle String?
  collectionTitle  String?
  type             String
  value            Float
  weight           Int
  minOrderValue    Float        @default(0)
  expiryValue Int    @default(48)
  expiryUnit  String @default("HOURS")
  segmentIds    String[]     @default([])
  maxIssued     Int?
  issuedCount   Int          @default(0)
  active        Boolean      @default(true)
  deletedAt     DateTime?
  config        ScratchConfig @relation(fields: [shop], references: [shop])
  cards         ScratchCard[]

  @@index([shop, active])
}

model ScratchCard {
  id               String         @id @default(cuid()) @map("_id")
  shop             String
  orderId          String
  orderName        String?
  customerId       String?
  rewardTemplateId String
  status           String         @default("ISSUED")
  discountCode     String?
  discountId       String?
  redeemedAt       DateTime?
  issuedAt         DateTime       @default(now())
  revealedAt       DateTime?
  expiresAt        DateTime?
  rewardTemplate   RewardTemplate @relation(fields: [rewardTemplateId], references: [id])

  @@unique([shop, orderId])
  @@index([shop, status, expiresAt])
  @@index([shop, customerId, issuedAt])
  @@index([shop, discountCode, status])
}
